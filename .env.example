# ==========================================
# Finance YouTube Automation - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# ==========================================
# Timezone Configuration
# ==========================================
TZ=UTC

# ==========================================
# Hugging Face API Configuration
# ==========================================
# Get a free token at: https://huggingface.co/settings/tokens
# Required for LLM API calls (free tier)
HUGGINGFACE_API_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ==========================================
# YouTube API Configuration
# ==========================================
# Required for automated video uploads
# Get credentials at: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token

# ==========================================
# Database Configuration (Optional - for future use)
# ==========================================
# PostgreSQL database connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=yt_automation
POSTGRES_USER=yt_user
POSTGRES_PASSWORD=your_postgres_password

# ==========================================
# Redis Configuration (Optional - for caching)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# Application Configuration
# ==========================================
# Enable/disable YouTube uploads
YOUTUBE_UPLOAD_ENABLED=true

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ==========================================
# Resource Limits (Optional - for Docker Compose)
# ==========================================
# Adjust based on your needs
DOCKER_CPU_LIMIT=2
DOCKER_MEMORY_LIMIT=2G
