# Finance YouTube Automation - Example Configuration
# Copy this to config/config.yaml and add your actual values

# Finance YouTube Automation Configuration
project_name: "finance-yt-automation"
version: "1.0.0"

# Agent configuration
agents:
  researcher:
    name: "content-researcher"
    model: "NousResearch/Nous-Hermes-2-Mixtral-8x7B-DPO"
    provider: "huggingface"
    max_tokens: 2048
    temperature: 0.7

  writer:
    name: "video-writer"
    model: "NousResearch/Nous-Hermes-2-Mixtral-8x7B-DPO"
    provider: "huggingface"
    max_tokens: 3072
    temperature: 0.8

  video_creator:
    name: "video-creator"
    model: "facebookresearch/audiocraft-musicgen-large"
    provider: "huggingface"
    max_tokens: 1024
    temperature: 0.5

  uploader:
    name: "video-uploader"
    model: "openai/gpt-3.5-turbo"
    provider: "openai"  # Will use free tier if available

# Finance topics for content
topics:
  budgeting:
    - "Budgeting for Beginners"
    - "How to Create a Monthly Budget"
    - "Zero-Based Budgeting Explained"
    - "Emergency Fund Setup Guide"
    - "Budgeting for High Earners"

  investing:
    - "Introduction to Stock Market"
    - "Dollar-Cost Averaging Strategy"
    - "Dividend Investing for Beginners"
    - "ETF vs Individual Stocks"
    - "Building a Diversified Portfolio"

  crypto:
    - "Cryptocurrency for Beginners"
    - "Bitcoin vs Ethereum: What's the Difference?"
    - "How to Buy Your First Cryptocurrency"
    - "Stablecoins Explained"
    - "Crypto Wallet Security Best Practices"

  retirement:
    - "Retirement Planning in Your 20s"
    - "401(k) vs IRA: Which is Better?"
    - "How Much Do You Need to Retire?"
    - "Retirement Accounts Explained"
    - "Social Security Optimization"

  real_estate:
    - "Real Estate Investing for Beginners"
    - "Rental Property vs REITs"
    - "How to Buy Your First Investment Property"
    - "Real Estate Tax Benefits"
    - "House Hacking Explained"

  debt_management:
    - "Debt Snowball vs Debt Avalanche"
    - "How to Negotiate Credit Card Debt"
    - "Student Loan Repayment Strategies"
    - "Debt Consolidation: Pros and Cons"
    - "How to Get Out of Debt Fast"

  passive_income:
    - "10 Passive Income Ideas"
    - "Dividend Stocks as Passive Income"
    - "Real Estate Crowdfunding"
    - "High-Yield Savings Accounts"
    - "Creating Digital Products for Passive Income"

# Scheduling
schedule:
  enabled: true
  time: "09:00"  # 9:00 AM UTC
  timezone: "UTC"
  run_every_day: true

# Output configuration
output:
  video_dir: "/app/data/videos"
  script_dir: "/app/data/scripts"
  audio_dir: "/app/data/audio"
  thumbnail_dir: "/app/data/thumbnails"
  upload_dir: "/app/data/uploads"

# YouTube API (for future uploads)
youtube:
  enabled: false  # Set to true when ready
  client_id: ""
  client_secret: ""

# Hugging Face API (for free LLM access)
# Get your token at: https://huggingface.co/settings/tokens
huggingface:
  api_token: ""  # Add your token here
  inference_api: "https://api-inference.huggingface.co/models"

# Logging
logging:
  level: "INFO"
  file: "/app/logs/automation.log"
